name: Preview

on:
  pull_request:
    types: [opened, reopened, synchronize]
    branches:
      - master

jobs:
  run:
    name: Preview
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: <%= checkoutAction %>

      - name: Setup Node
        uses: <%= setupNodeAction %>
        with:
          node-version: '<%= nodeVersion %>'

      - name: Install
        run: yarn install

      - name: Changes
        run: yarn files changed list
        env:
          GITHUB_TOKEN: '${{ secrets.GITHUB_TOKEN }}'

      - name: Install Buildpack Cli
        run: |
          (curl -sSL "https://github.com/buildpacks/pack/releases/download/v0.40.4/pack-v0.40.4-linux.tgz" | sudo tar -C /usr/local/bin/ --no-same-owner -xzv pack)

      - name: Login to GitHub Container Registry
        run: echo "${{ secrets.GITHUB_TOKEN }}" | docker login <%= containerRegistry %> -u "${{ github.actor }}" --password-stdin

      - name: Preview
        env:
          GITHUB_TOKEN: '${{ secrets.GITHUB_TOKEN }}'
        run: |
          repository="$(printf '%s' '${{ <%= containerRepositoryExpression %> }}' | tr '[:upper:]' '[:lower:]')"
          yarn workspaces changed foreach run app pack \
            --registry "<%= containerRegistry %>/${repository}-" \
            --tag-policy ctx-hash-timestamp \
            --publish
