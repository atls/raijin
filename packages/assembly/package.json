{
  "name": "@atls/raijin-assembly",
  "version": "4.18.0",
  "private": true,
  "description": "Checked Yarn runtime assembly for Raijin",
  "homepage": "https://github.com/atls/raijin#readme",
  "bugs": {
    "url": "https://github.com/atls/raijin/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/atls/raijin.git",
    "directory": "packages/assembly"
  },
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "yarn run build:clean && yarn run build:bundle && yarn run build:dynamic-require && yarn run build:dist && yarn run build:materialize",
    "build:bundle": "builder build bundle --no-git-hash --format esm --target esnext --external-file ./externals.json",
    "build:clean": "rm -rf dist/runtime",
    "build:dist": "mkdir -p dist/runtime && mv bundles/yarn.js dist/runtime/yarn.js",
    "build:dynamic-require": "yarn node patches/dynamic-require.js",
    "build:materialize": "yarn node scripts/runtime/materialize.js"
  },
  "dependencies": {
    "@atls/raijin": "workspace:*",
    "@atls/yarn-plugin-check": "workspace:*",
    "@atls/yarn-plugin-commit": "workspace:*",
    "@atls/yarn-plugin-essentials": "workspace:*",
    "@atls/yarn-plugin-format": "workspace:*",
    "@atls/yarn-plugin-generate": "workspace:*",
    "@atls/yarn-plugin-image": "workspace:*",
    "@atls/yarn-plugin-library": "workspace:*",
    "@atls/yarn-plugin-lint": "workspace:*",
    "@atls/yarn-plugin-renderer": "workspace:*",
    "@atls/yarn-plugin-service": "workspace:*",
    "@atls/yarn-plugin-test": "workspace:*",
    "@atls/yarn-plugin-tools": "workspace:*",
    "@atls/yarn-plugin-typescript": "workspace:*",
    "@yarnpkg/builder": "https://github.com/TorinAsakura/yarnpkg-builder.git#commit=05a30e58225e52c7fa61664aa939f1fd7fedb7b6",
    "@yarnpkg/cli": "4.18.0",
    "@yarnpkg/core": "4.9.1",
    "@yarnpkg/fslib": "3.1.5",
    "@yarnpkg/libzip": "3.2.2",
    "@yarnpkg/parsers": "3.1.0",
    "@yarnpkg/plugin-catalog": "1.0.3",
    "@yarnpkg/plugin-compat": "4.0.14",
    "@yarnpkg/plugin-constraints": "4.0.6",
    "@yarnpkg/plugin-dlx": "4.0.3",
    "@yarnpkg/plugin-essentials": "4.6.2",
    "@yarnpkg/plugin-exec": "3.1.1",
    "@yarnpkg/plugin-file": "3.0.3",
    "@yarnpkg/plugin-git": "patch:@yarnpkg/plugin-git@npm%3A3.2.1#~/.yarn/patches/@yarnpkg-plugin-git-npm-3.2.1.patch",
    "@yarnpkg/plugin-github": "3.0.3",
    "@yarnpkg/plugin-http": "3.0.4",
    "@yarnpkg/plugin-init": "4.1.3",
    "@yarnpkg/plugin-interactive-tools": "4.1.1",
    "@yarnpkg/plugin-jsr": "1.1.2",
    "@yarnpkg/plugin-link": "3.0.3",
    "@yarnpkg/plugin-nm": "4.1.1",
    "@yarnpkg/plugin-npm": "3.7.1",
    "@yarnpkg/plugin-npm-cli": "4.5.1",
    "@yarnpkg/plugin-pack": "4.0.5",
    "@yarnpkg/plugin-patch": "4.0.6",
    "@yarnpkg/plugin-pnp": "4.2.1",
    "@yarnpkg/plugin-pnpm": "2.3.1",
    "@yarnpkg/plugin-stage": "4.0.3",
    "@yarnpkg/plugin-typescript": "4.1.4",
    "@yarnpkg/plugin-version": "4.3.0",
    "@yarnpkg/plugin-workspace-tools": "4.1.8",
    "@yarnpkg/pnp": "4.1.7",
    "@yarnpkg/shell": "4.1.3",
    "clipanion": "4.0.0-rc.2",
    "semver": "7.6.3",
    "typanion": "3.14.0"
  },
  "@yarnpkg/builder": {
    "bundles": {
      "standard": [
        "@atls/yarn-plugin-check",
        "@atls/yarn-plugin-commit",
        "@atls/yarn-plugin-essentials",
        "@atls/yarn-plugin-format",
        "@atls/yarn-plugin-image",
        "@atls/yarn-plugin-library",
        "@atls/yarn-plugin-lint",
        "@atls/yarn-plugin-renderer",
        "@atls/yarn-plugin-service",
        "@atls/yarn-plugin-test",
        "@atls/yarn-plugin-tools",
        "@atls/yarn-plugin-typescript",
        "@atls/yarn-plugin-generate",
        "@yarnpkg/plugin-interactive-tools",
        "@yarnpkg/plugin-jsr",
        "@yarnpkg/plugin-workspace-tools",
        "@yarnpkg/plugin-typescript",
        "@yarnpkg/plugin-version",
        "@yarnpkg/plugin-essentials",
        "@yarnpkg/plugin-catalog",
        "@yarnpkg/plugin-compat",
        "@yarnpkg/plugin-constraints",
        "@yarnpkg/plugin-dlx",
        "@yarnpkg/plugin-exec",
        "@yarnpkg/plugin-file",
        "@yarnpkg/plugin-git",
        "@yarnpkg/plugin-github",
        "@yarnpkg/plugin-http",
        "@yarnpkg/plugin-init",
        "@yarnpkg/plugin-link",
        "@yarnpkg/plugin-nm",
        "@yarnpkg/plugin-npm",
        "@yarnpkg/plugin-npm-cli",
        "@yarnpkg/plugin-pack",
        "@yarnpkg/plugin-patch",
        "@yarnpkg/plugin-pnp",
        "@yarnpkg/plugin-pnpm",
        "@yarnpkg/plugin-stage"
      ]
    }
  }
}
