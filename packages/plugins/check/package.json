{
  "name": "@atls/yarn-plugin-check",
  "version": "1.0.20",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "builder build plugin --external-file ../../assembly/externals.json --external @atls/raijin/runtime-resolver",
    "prepack": "yarn run build",
    "postpack": "rm -rf dist"
  },
  "dependencies": {
    "@atls/raijin": "workspace:*",
    "@atls/yarn-plugin-format": "workspace:*",
    "@atls/yarn-plugin-lint": "workspace:*",
    "@atls/yarn-plugin-test": "workspace:*",
    "@atls/yarn-plugin-typescript": "workspace:*",
    "@yarnpkg/plugin-git": "3.2.0",
    "clipanion": "4.0.0-rc.2"
  },
  "devDependencies": {
    "@yarnpkg/builder": "4.2.0",
    "@yarnpkg/cli": "4.14.1",
    "@yarnpkg/core": "4.7.0",
    "@yarnpkg/fslib": "3.1.5"
  },
  "peerDependencies": {
    "@yarnpkg/cli": "*",
    "@yarnpkg/core": "*",
    "@yarnpkg/fslib": "*"
  },
  "raijin": {
    "pack": {
      "exports": {
        "./package.json": "./package.json",
        ".": {
          "import": "./dist/index.js",
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        }
      },
      "main": "dist/index.js",
      "types": "dist/index.d.ts"
    }
  }
}
