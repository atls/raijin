{
  "name": "@atls/yarn-plugin-commit",
  "version": "1.0.12",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "main": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "builder build plugin",
    "prepack": "yarn run build",
    "postpack": "rm -rf dist"
  },
  "dependencies": {
    "@atls/raijin": "workspace:*",
    "@commitlint/format": "21.2.0",
    "@commitlint/lint": "21.2.0",
    "@commitlint/read": "21.2.0",
    "@commitlint/types": "21.2.0",
    "@yarnpkg/libui": "3.0.1",
    "clipanion": "4.0.0-rc.2",
    "commitizen": "4.3.0",
    "figures": "6.1.0",
    "force-stdin-tty": "0.0.1",
    "ink": "3.2.0",
    "ink-multi-select": "2.0.0",
    "ink-select-input": "6.0.0",
    "ink-text-input": "6.0.0",
    "lint-staged": "patch:lint-staged@npm%3A17.5.0#~/.yarn/patches/lint-staged-npm-17.5.0.patch",
    "react": "18.3.1",
    "word-wrap": "1.2.5"
  },
  "devDependencies": {
    "@types/react": "18.3.18",
    "@yarnpkg/builder": "4.2.0",
    "@yarnpkg/cli": "4.14.1",
    "@yarnpkg/core": "4.7.0",
    "@yarnpkg/fslib": "3.1.5"
  },
  "peerDependencies": {
    "@yarnpkg/cli": "*",
    "@yarnpkg/core": "*"
  },
  "raijin": {
    "pack": {
      "exports": {
        "./package.json": "./package.json",
        ".": {
          "import": "./dist/index.js",
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        }
      },
      "main": "dist/index.js",
      "types": "dist/index.d.ts"
    }
  }
}
