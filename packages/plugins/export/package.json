{
  "name": "@atls/yarn-plugin-export",
  "version": "1.0.8",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": "./src/index.ts",
    "./artifact": "./src/artifact/index.ts"
  },
  "main": "src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "builder build plugin",
    "prepack": "yarn run build",
    "postpack": "rm -rf dist"
  },
  "dependencies": {
    "@atls/raijin": "workspace:*",
    "clipanion": "4.0.0-rc.2",
    "semver": "7.6.3",
    "tar-stream": "3.1.7"
  },
  "devDependencies": {
    "@types/semver": "7.5.8",
    "@yarnpkg/builder": "4.2.0",
    "@yarnpkg/cli": "4.14.1",
    "@yarnpkg/core": "4.7.0",
    "@yarnpkg/fslib": "3.1.5",
    "@yarnpkg/plugin-pack": "4.0.4",
    "@yarnpkg/plugin-patch": "4.0.3",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "@yarnpkg/cli": "*",
    "@yarnpkg/core": "*"
  },
  "raijin": {
    "pack": {
      "exports": {
        "./package.json": "./package.json",
        ".": {
          "import": "./dist/index.js",
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "./artifact": {
          "import": "./dist/artifact/index.js",
          "types": "./dist/artifact/index.d.ts",
          "default": "./dist/artifact/index.js"
        }
      },
      "main": "dist/index.js",
      "types": "dist/index.d.ts"
    }
  }
}
